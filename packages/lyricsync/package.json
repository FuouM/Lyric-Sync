{
  "name": "lyricsync",
  "version": "0.1.0",
  "description": "End-to-end singing-voice lyrics timing: vocal stem + lyrics text in, word- and syllable-level lyrics.json out. Free, line-anchored and interactively refined modes.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lyricsync": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "models",
    "weights",
    "docs",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && node scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "beatsync": "file:../beatsync",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
